---
layout: base.njk
lang: en
title: Maciej Czerpiński - Tech Lead
---
<section class="hero">
  <h1>{{ copy.en.hero.greeting }}</h1>
  {% for line in copy.en.hero.lines %}
  <p>{{ line }}</p>
  {% endfor %}
  <p class="hero__talents">{{ copy.en.hero.talents }}</p>
</section>

<section id="about">
  <h2>{{ copy.en.about.heading }}</h2>
  {% for p in copy.en.about.paragraphs %}
  <p>{{ p }}</p>
  {% endfor %}
</section>

<section id="training">
  <h2>{{ copy.en.training.heading }}</h2>
  {% for p in copy.en.training.paragraphs %}
  <p>{{ p }}</p>
  {% endfor %}
  <a class="cta" href="{{ copy.en.training.ctaHref }}">{{ copy.en.training.ctaLabel }} &rarr;</a>

  <!-- TODO: PLACEHOLDER - replace testimonials below with real ones before publishing -->
  {% for t in testimonials.en %}
  <div class="testimonial">
    <p>&ldquo;{{ t.quote }}&rdquo;</p>
    <div class="testimonial__name">{{ t.name }} - {{ t.role }}</div>
  </div>
  {% endfor %}
</section>

<section id="blog-teaser">
  <h2>{{ copy.en.blogTeaser.heading }}</h2>
  {% for post in collections.post %}
  {% if loop.index <= 3 %}
  <div class="blog-list__item">
    <a href="{{ post.url }}">{{ post.data.title }}</a>
  </div>
  {% endif %}
  {% endfor %}
  <a class="cta" href="/blog/">{{ copy.en.blogTeaser.viewAllLabel }} &rarr;</a>
</section>
