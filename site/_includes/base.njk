<!doctype html>
<html lang="{{ lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title or "Maciej Czerpiński" }}</title>
  <meta name="description" content="Tech Lead. AI-assisted development, Spec-Driven Development, Event Storming, DDD, Clean Code training.">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <a class="site-header__name" href="{{ '/' if lang == 'en' else '/pl/' }}">Maciej Czerpiński</a>
    <nav class="site-nav">
      {% for item in copy[lang].nav %}
      <a href="{{ item.href }}">{{ item.label }}</a>
      {% endfor %}
      <a href="{{ copy[lang].langSwitch.href }}" class="lang-switch">{{ copy[lang].langSwitch.label }}</a>
    </nav>
  </header>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site-footer" id="contact">
    <div>&copy; 2026 Maciej Czerpiński</div>
    <div class="site-footer__links">
      <a href="https://www.linkedin.com/in/maciejczerpinski/">LinkedIn</a>
      <a href="https://github.com/speccode">GitHub</a>
      <a href="mailto:hello@speccode.com">hello@speccode.com</a>
    </div>
  </footer>
</body>
</html>
